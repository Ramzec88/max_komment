# Токен бота — получите у @MaxBotFather в мессенджере Max
MAX_BOT_TOKEN=your_token_here

# --- Вариант 1: несколько каналов (рекомендуется) ---
# Формат: channel_id|chat_url  разделённые через «;»
# CHANNELS=-111111111111|https://max.ru/join/hash1;-222222222222|https://max.ru/join/hash2

# --- Вариант 2: один канал (старый формат, для обратной совместимости) ---
# CHANNEL_ID=0 означает «все каналы где бот является администратором»
CHANNEL_ID=0
CHAT_URL=https://max.ru/join/invite_hash

# Текст на кнопке (по умолчанию: 💬 Обсудить в чате)
BUTTON_TEXT=💬 Обсудить в чате

# user_id администраторов бота через запятую (могут использовать команды)
# Если не задано — команды доступны всем, кто пишет боту
ADMIN_USER_IDS=9977437,123456789

# Путь к SQLite-базе (для Railway: смонтируйте volume и укажите /data/channels.db)
DB_PATH=channels.db
