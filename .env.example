# Токен бота — получите у @MaxBotFather в мессенджере Max
MAX_BOT_TOKEN=your_token_here

# ID канала, в котором бот будет добавлять кнопки к постам
# Установите 0, чтобы бот реагировал на посты во ВСЕХ каналах, где он администратор
CHANNEL_ID=123456789

# Ссылка на чат/группу для кнопки (публичная ссылка или инвайт)
CHAT_URL=https://max.ru/join/invite_hash

# Текст на кнопке (по умолчанию: 💬 Обсудить в чате)
BUTTON_TEXT=💬 Обсудить в чате
